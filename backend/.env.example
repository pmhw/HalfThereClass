# 服务配置
PORT=3000
NODE_ENV=development

# 数据库配置
DATABASE_URL="file:./dev.db"

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置（首次启动若仍是占位符，服务会自动生成强密钥并写回 .env）
JWT_SECRET=CHANGE_ME_AUTO_GENERATE_ON_BOOT
JWT_EXPIRES_IN=7d
# 管理后台 token 有效期（建议短于用户端）
ADMIN_JWT_EXPIRES_IN=12h

# 管理后台初始超管（仅在数据库中尚无任何管理员时生效）
# 密码至少 10 位，且不能是 admin123 等弱口令；留空则启动时自动生成并打印到日志
ADMIN_USER=admin
ADMIN_PASSWORD=

# 可选：浏览器跨域来源白名单，逗号分隔。生产默认仅同源。
# CORS_ORIGIN=https://example.com
# 生产如需开放 Swagger：ENABLE_SWAGGER=1
# 手机网页登录开关（默认开启）：MOBILE_LOGIN=1
# 仅本地调试微信：ALLOW_DEV_WX=1
# 开发环境发送短信后会在服务日志打印验证码；也可设 ALLOW_DEV_SMS=1

# 微信小程序配置
WX_APPID=your-wx-appid
WX_SECRET=your-wx-secret

# 阿里云短信（也可在后台「系统设置 → 阿里云短信」配置，后台优先）
# SMS_ENABLED=1
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=SMS_xxxx
# SMS_TEMPLATE_PARAM=code

# 发布仓库（后台检查更新用）
GITHUB_REPO=pmhw/HalfThereClass
# GITHUB_TOKEN=  # 可选；私有仓库读 Release 时需要
# 国内服务器建议开启（在线更新走代理 + npm 淘宝源）
# CN_MIRROR=1
# GITHUB_PROXY=https://ghfast.top/

# 微信支付配置
WX_PAY_MCH_ID=your-mch-id
WX_PAY_KEY=your-pay-key
WX_PAY_CERT_PATH=./certs/apiclient_cert.pem
WX_PAY_KEY_PATH=./certs/apiclient_key.pem

# 七牛云配置
QINIU_ACCESS_KEY=your-access-key
QINIU_SECRET_KEY=your-secret-key
QINIU_BUCKET=half-there-class
QINIU_DOMAIN=https://cdn.example.com
