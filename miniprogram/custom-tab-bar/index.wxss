.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  box-sizing: border-box;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.38);
  border-top: 1rpx solid rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(28px) saturate(180%);
  -webkit-backdrop-filter: blur(28px) saturate(180%);
}
.shell {
  position: relative;
  width: 100%;
  height: 112rpx;
  border-radius: 999rpx;
  overflow: hidden;
  display: flex;
  background: rgba(255, 255, 255, 0.28);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06), inset 0 1rpx 0 rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(18px) saturate(160%);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
}
.shine {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 50%;
  border-radius: 999rpx 999rpx 0 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.6), transparent);
  pointer-events: none;
  z-index: 0;
}
.pill {
  position: absolute;
  top: 50%;
  height: 96rpx;
  margin-top: -48rpx;
  border-radius: 48rpx;
  background: linear-gradient(180deg, rgba(37, 99, 235, 0.16), rgba(37, 99, 235, 0.08));
  border: 1rpx solid rgba(37, 99, 235, 0.12);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.28);
  z-index: 1;
  pointer-events: none;
  transition: left 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), width 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.item {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.item-hover { opacity: 0.88; }
.icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 2rpx;
  opacity: 0.78;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.25s ease;
}
.item.on .icon {
  transform: scale(1.12) translateY(-2rpx);
  opacity: 1;
}
.label-box {
  position: relative;
  height: 32rpx;
  max-width: 100%;
}
.label {
  display: block;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 500;
  color: rgba(30, 32, 36, 0.78);
  text-align: center;
  white-space: nowrap;
}
.label.reflect {
  position: absolute;
  left: 0;
  right: 0;
  top: 8rpx;
  color: rgba(30, 32, 36, 0.7);
  transform: scaleY(-1);
  opacity: 0.15;
  pointer-events: none;
}
.item.on .label {
  color: #2563eb;
  font-weight: 700;
}
.item.on .label.reflect {
  color: #2563eb;
  opacity: 0.22;
}
