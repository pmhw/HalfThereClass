.page { padding: 24rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.tip { color: #667085; font-size: 24rpx; margin-bottom: 16rpx; }
.form { margin-bottom: 28rpx; }
.label { color: #667085; font-size: 26rpx; }
.label.gap { margin-top: 24rpx; }
.input {
  margin-top: 12rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #e7edf5;
}
.input input { height: 88rpx; font-size: 28rpx; }
.input.picker { height: 88rpx; line-height: 88rpx; font-size: 28rpx; color: #111827; }
.input.area { padding: 16rpx 24rpx; }
.input textarea { width: 100%; height: 120rpx; font-size: 28rpx; }
.shots { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.shot, .add {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
}
.shot image { width: 100%; height: 100%; }
.rm {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  text-align: center;
  line-height: 34rpx;
  font-size: 24rpx;
}
.add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #cbd5e1;
  color: #94a3b8;
  font-size: 48rpx;
}
.submit { margin-top: 28rpx; }
.sec { font-size: 30rpx; font-weight: 650; margin: 8rpx 0 16rpx; }
.row { display: flex; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; }
.title { font-weight: 650; }
.meta { margin-top: 6rpx; color: #98a2b3; font-size: 24rpx; }
.reject { margin-top: 6rpx; color: #dc2626; font-size: 24rpx; }
.right { text-align: right; }
.fee { color: #2563eb; font-weight: 700; }
.link { margin-top: 8rpx; color: #dc2626; font-size: 24rpx; }
.empty { text-align: center; color: #98a2b3; padding: 40rpx 0; }
