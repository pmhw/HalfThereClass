<view class="page">
  <view class="tip">提交后需管理员审核通过，方可报销打款。</view>

  <view class="card form">
    <view class="label">报销事由</view>
    <view class="input">
      <input value="{{title}}" maxlength="80" placeholder="例如：教研交通费" bindinput="onTitle" />
    </view>
    <view class="label gap">类别</view>
    <picker mode="selector" range="{{categoryLabels}}" value="{{categoryIndex}}" bindchange="onCategory">
      <view class="input picker">{{categoryLabels[categoryIndex]}}</view>
    </picker>
    <view class="label gap">金额（元）</view>
    <view class="input">
      <input type="digit" value="{{amount}}" placeholder="0.00" bindinput="onAmount" />
    </view>
    <view class="label gap">发生日期</view>
    <picker mode="date" value="{{expenseDate}}" bindchange="onDate">
      <view class="input picker">{{expenseDate || '请选择'}}</view>
    </picker>
    <view class="label gap">说明</view>
    <view class="input area">
      <textarea value="{{description}}" maxlength="500" placeholder="选填" bindinput="onDesc" />
    </view>
    <view class="label gap">票据凭证</view>
    <view class="shots">
      <view class="shot" wx:for="{{attachments}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill"></image>
        <view class="rm" data-index="{{index}}" catchtap="removeShot">×</view>
      </view>
      <view class="add" wx:if="{{attachments.length < 9}}" bindtap="pickShot">+</view>
    </view>
    <button class="btn btn-primary btn-block submit" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">
      {{saving ? '提交中…' : '提交审核'}}
    </button>
  </view>

  <view class="sec">我的报销单</view>
  <view wx:if="{{!list.length}}" class="empty">暂无记录</view>
  <view class="card row" wx:for="{{list}}" wx:key="id">
    <view class="main">
      <view class="title">{{item.title}}</view>
      <view class="meta">{{item.categoryLabel}} · {{item.expenseDate}}</view>
      <view class="meta">{{item.statusLabel}}</view>
      <view class="reject" wx:if="{{item.rejectReason}}">{{item.rejectReason}}</view>
    </view>
    <view class="right">
      <view class="fee">¥{{item.amountText}}</view>
      <view class="link" wx:if="{{item.status === 'pending'}}" data-id="{{item.id}}" bindtap="cancel">撤销</view>
    </view>
  </view>
</view>
