.page {
  background: #f7f8fa;
  min-height: 100vh;
}

.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ff6b35;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #ff6b35;
  border-radius: 2rpx;
}

.order-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-item {
  padding: 0;
  overflow: hidden;
}

.order-header {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 26rpx;
}

.order-no {
  color: #999;
}

.order-status {
  font-weight: 500;
}

.order-status.pending {
  color: #ff6b35;
}

.order-status.paid {
  color: #07c160;
}

.order-body {
  display: flex;
  padding: 20rpx 24rpx;
}

.course-cover {
  width: 140rpx;
  height: 100rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.course-info {
  flex: 1;
  margin-left: 20rpx;
}

.course-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}

.order-footer {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f5f5f5;
  font-size: 26rpx;
  color: #666;
}

.price {
  color: #ff6b35;
  font-size: 32rpx;
  font-weight: bold;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}
