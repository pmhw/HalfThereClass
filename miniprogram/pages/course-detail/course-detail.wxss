.page { padding-bottom: 260rpx; }
.top-actions {
  display: flex;
  justify-content: flex-end;
  padding: 8rpx 24rpx 0;
}
.link-btn {
  margin: 0;
  padding: 0 8rpx;
  background: transparent;
  border: 0;
  color: #2563eb;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}
.link-btn::after { border: 0; }
.banner {
  height: 280rpx;
  margin: 24rpx;
  border-radius: 32rpx;
  background: #eef4ff;
  color: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  font-weight: 700;
}
.main, .block { margin: 0 24rpx 20rpx; padding: 28rpx; }
.title { font-size: 40rpx; font-weight: 700; }
.rate, .line, .p, .lesson { margin-top: 10rpx; color: #667085; font-size: 26rpx; }
.price { margin-top: 18rpx; color: #2563eb; font-size: 36rpx; font-weight: 700; }
.lock { margin-top: 18rpx; color: #98a2b3; font-size: 24rpx; }
.h { font-size: 30rpx; font-weight: 650; }
.bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #e7edf5;
}
.bar-row { display: flex; gap: 16rpx; }
.bar-row .btn { flex: 1; }
.remind { margin-top: 16rpx; }
.loc-map { width: 100%; height: 320rpx; margin-top: 20rpx; border-radius: 20rpx; overflow: hidden; }
.loc-info { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 20rpx; }
.loc-text { flex: 1; min-width: 0; }
.loc-name { font-size: 28rpx; font-weight: 600; color: #101828; }
.loc-room { color: #667085; font-weight: 400; }
.loc-addr { margin-top: 6rpx; color: #667085; font-size: 24rpx; line-height: 1.5; }
.loc-copy {
  flex: none; margin: 0; padding: 0 22rpx; height: 52rpx; line-height: 52rpx;
  border-radius: 26rpx; background: #f2f4f7; color: #475467; font-size: 24rpx;
}
.loc-copy::after { border: 0; }
.loc-nav { margin-top: 20rpx; }
