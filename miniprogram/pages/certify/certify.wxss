.page { padding: 0 28rpx 48rpx; background: #f4f7fb; min-height: 100vh; box-sizing: border-box; }
.nav { display: flex; align-items: center; }
.back { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.back::before {
  content: ''; width: 16rpx; height: 16rpx; margin-left: 6rpx;
  border-left: 4rpx solid #111827; border-bottom: 4rpx solid #111827; transform: rotate(45deg);
}
.nav-title { margin-left: 4rpx; font-size: 34rpx; font-weight: 650; color: #111827; line-height: 1; }
.steps { display: flex; align-items: flex-start; justify-content: space-between; padding: 12rpx 4rpx 0; }
.step { display: flex; flex-direction: column; align-items: center; gap: 10rpx; color: #98a2b3; font-size: 22rpx; width: 140rpx; }
.step .n {
  width: 48rpx; height: 48rpx; border-radius: 50%; background: #e7edf5; color: #98a2b3;
  display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 700;
}
.step.on { color: #2563eb; font-weight: 650; }
.step.on .n { background: #2563eb; color: #fff; }
.bar { flex: 1; height: 4rpx; background: #e7edf5; margin: 22rpx 0 0; }
.bar.on { background: #2563eb; }
.hint { margin: 22rpx 8rpx 18rpx; color: #98a2b3; font-size: 24rpx; }
.form, .done, .wait { padding: 32rpx 28rpx; margin-bottom: 20rpx; border-radius: 24rpx; }
.label { font-size: 30rpx; font-weight: 650; color: #111827; }
.label.gap { margin-top: 36rpx; }
.req { color: #ef4444; margin-left: 4rpx; }
.desc { margin-top: 10rpx; color: #98a2b3; font-size: 22rpx; line-height: 1.55; }
.input {
  margin-top: 16rpx; height: 92rpx; padding: 0 24rpx; border-radius: 16rpx; background: #f3f5f8;
  display: flex; align-items: center; gap: 16rpx;
}
.input input { flex: 1; height: 92rpx; font-size: 28rpx; color: #111827; }
.ph { color: #c0c6d0; }
.person {
  width: 28rpx; height: 28rpx; border: 3rpx solid #b0b8c4; border-radius: 50%; box-sizing: border-box; position: relative; flex-shrink: 0;
}
.person::after {
  content: ''; position: absolute; left: 2rpx; right: 2rpx; bottom: -12rpx; height: 10rpx;
  border: 3rpx solid #b0b8c4; border-bottom: 0; border-radius: 12rpx 12rpx 0 0;
}
.row {
  display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; padding: 20rpx;
  border-radius: 18rpx; background: #f3f5f8;
}
.id-row { margin-bottom: 0; border-radius: 18rpx 18rpx 0 0; padding-bottom: 8rpx; }
.txt { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 650; color: #111827; }
.sub { margin-top: 6rpx; color: #98a2b3; font-size: 22rpx; font-weight: 400; }
.plus {
  width: 56rpx; height: 56rpx; border-radius: 16rpx; background: #2563eb; color: #fff;
  font-size: 40rpx; font-weight: 500; line-height: 52rpx; text-align: center; flex-shrink: 0;
}
.plus.done { background: #dcfce7; color: #059669; font-size: 28rpx; line-height: 56rpx; }
.badge { width: 72rpx; height: 72rpx; border-radius: 18rpx; flex-shrink: 0; position: relative; }
.id { background: #dbeafe; }
.edu { background: #ede9fe; }
.cert { background: #dcfce7; }
.law { background: #ffedd5; }
.id-card {
  position: absolute; left: 16rpx; top: 22rpx; width: 40rpx; height: 28rpx;
  border-radius: 4rpx; background: #fff; border: 3rpx solid #2563eb; box-sizing: border-box;
}
.id-face {
  position: absolute; right: 4rpx; top: 4rpx; width: 10rpx; height: 14rpx; border-radius: 2rpx; background: #2563eb;
}
.cap {
  position: absolute; left: 14rpx; top: 22rpx; width: 44rpx; height: 14rpx; background: #7c3aed;
  clip-path: polygon(50% 0, 100% 100%, 0 100%);
}
.tassel {
  position: absolute; left: 32rpx; top: 38rpx; width: 8rpx; height: 16rpx; background: #7c3aed; border-radius: 0 0 4rpx 4rpx;
}
.sheet {
  position: absolute; left: 20rpx; top: 16rpx; width: 32rpx; height: 40rpx; border-radius: 4rpx;
  background: #fff; border: 3rpx solid #16a34a; box-sizing: border-box;
}
.seal {
  position: absolute; right: -6rpx; bottom: 4rpx; width: 16rpx; height: 16rpx; border-radius: 50%;
  border: 3rpx solid #16a34a; box-sizing: border-box;
}
.doc {
  position: absolute; left: 22rpx; top: 16rpx; width: 28rpx; height: 36rpx; border-radius: 4rpx;
  border: 3rpx solid #ea580c; box-sizing: border-box;
}
.doc::before, .doc::after {
  content: ''; position: absolute; left: 5rpx; right: 5rpx; height: 3rpx; background: #ea580c; border-radius: 2rpx;
}
.doc::before { top: 10rpx; }
.doc::after { top: 18rpx; right: 10rpx; }
.slots { display: flex; gap: 16rpx; padding: 8rpx 20rpx 20rpx; background: #f3f5f8; border-radius: 0 0 18rpx 18rpx; }
.slot {
  position: relative; flex: 1; height: 196rpx; border-radius: 12rpx; overflow: hidden;
  background: #fff; border: 2rpx dashed #93c5fd; box-sizing: border-box;
}
.slot image { width: 100%; height: 100%; }
.mark { position: absolute; width: 22rpx; height: 22rpx; border-color: #2563eb; border-style: solid; }
.tl { left: 12rpx; top: 12rpx; border-width: 4rpx 0 0 4rpx; }
.tr { right: 12rpx; top: 12rpx; border-width: 4rpx 4rpx 0 0; }
.bl { left: 12rpx; bottom: 12rpx; border-width: 0 0 4rpx 4rpx; }
.br { right: 12rpx; bottom: 12rpx; border-width: 0 4rpx 4rpx 0; }
.slot-name { position: absolute; left: 0; right: 0; top: 62rpx; text-align: center; color: #1d4ed8; font-size: 26rpx; font-weight: 650; }
.slot-tip { position: absolute; left: 0; right: 0; top: 102rpx; text-align: center; color: #93a4bd; font-size: 20rpx; }
.slot-tag {
  position: absolute; left: 8rpx; bottom: 8rpx; padding: 2rpx 10rpx; border-radius: 8rpx;
  background: rgba(15, 23, 42, 0.55); color: #fff; font-size: 20rpx;
}
.warn { color: #b45309; font-size: 26rpx; line-height: 1.5; }
.h { font-size: 34rpx; font-weight: 700; color: #059669; }
.wait .h { color: #2563eb; }
.done .sub, .wait .sub { margin-top: 8rpx; color: #6b7280; }
.sign { margin-top: 28rpx; height: 88rpx; border-radius: 44rpx; }
.submit { margin-top: 8rpx; height: 96rpx; border-radius: 48rpx; font-size: 32rpx; font-weight: 650; }
.foot { margin-top: 18rpx; text-align: center; color: #98a2b3; font-size: 22rpx; line-height: 1.5; }
