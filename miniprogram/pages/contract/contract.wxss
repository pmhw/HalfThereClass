.page {
  min-height: 100vh;
  background: #eef2f7;
  padding: 24rpx 28rpx 56rpx;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.04);
}
.paper-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 20rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid #eef2f6;
}
.seal {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.title, .h {
  font-size: 34rpx;
  font-weight: 750;
  color: #111827;
  letter-spacing: 0.02em;
}
.badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfdf3;
  color: #059669;
  font-size: 22rpx;
  font-weight: 650;
  margin-bottom: 12rpx;
}
.done .h { color: #111827; margin-bottom: 8rpx; }
.wait .h { color: #2563eb; }
.sub {
  margin-top: 8rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.55;
}
.body {
  height: 58vh;
  min-height: 520rpx;
  max-height: 760rpx;
  margin-top: 8rpx;
  box-sizing: border-box;
}
.signed-body {
  height: 42vh;
  min-height: 360rpx;
  max-height: 560rpx;
  margin-top: 20rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #e5e7eb;
}
.label { font-size: 30rpx; font-weight: 650; color: #111827; }
.req { color: #ef4444; margin-left: 4rpx; }
.hint, .foot { margin-top: 8rpx; color: #98a2b3; font-size: 22rpx; }
.foot { text-align: center; margin-top: 16rpx; }
.pad-wrap {
  position: relative;
  margin-top: 16rpx;
  height: 280rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 2rpx dashed #cbd5e1;
  overflow: hidden;
}
.pad { width: 100%; height: 280rpx; }
.placeholder {
  position: absolute;
  left: 0;
  right: 0;
  top: 112rpx;
  text-align: center;
  color: #cbd5e1;
  font-size: 28rpx;
  pointer-events: none;
}
.clear { margin-top: 12rpx; text-align: right; color: #2563eb; font-size: 26rpx; }
.agree {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 8rpx 4rpx 20rpx;
  color: #344054;
  font-size: 26rpx;
}
.box {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid #cbd5e1;
  box-sizing: border-box;
  flex-shrink: 0;
}
.box.on { background: #2563eb; border-color: #2563eb; }
.submit, .go { height: 92rpx; border-radius: 46rpx; font-size: 32rpx; }
.go { margin-top: 24rpx; }
.sign-box {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e5e7eb;
}
.sign-label {
  margin-bottom: 10rpx;
  color: #667085;
  font-size: 24rpx;
}
.sign-img {
  width: 100%;
  height: 180rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}
