.page {
  min-height: 100vh;
  background: #eef2f7;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.04);
}
.paper-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 20rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid #eef2f6;
}
.seal {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.title, .h {
  font-size: 34rpx;
  font-weight: 750;
  color: #111827;
  letter-spacing: 0.02em;
}
.done .h { color: #111827; margin-bottom: 8rpx; }
.wait .h { color: #2563eb; }
.body-label {
  margin: 8rpx 0 4rpx;
  color: #98a2b3;
  font-size: 22rpx;
}
.body {
  /* 固定高度别占满屏，留给下方签名区；页面本身可滚动 */
  height: 42vh;
  min-height: 360rpx;
  max-height: 560rpx;
  margin-top: 8rpx;
  box-sizing: border-box;
}
.signed-body {
  height: 36vh;
  min-height: 300rpx;
  max-height: 480rpx;
  margin-top: 20rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #e5e7eb;
}
.label { font-size: 30rpx; font-weight: 650; color: #111827; }
.req { color: #ef4444; margin-left: 4rpx; }
.hint { margin-top: 8rpx; color: #98a2b3; font-size: 22rpx; line-height: 1.5; }
.foot { text-align: center; color: #98a2b3; font-size: 22rpx; margin-top: 16rpx; padding-bottom: 24rpx; }
.sign-card {
  scroll-margin-top: 24rpx;
}
.pad-wrap {
  position: relative;
  margin-top: 16rpx;
  height: 280rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 2rpx dashed #cbd5e1;
  overflow: hidden;
}
.pad { width: 100%; height: 280rpx; }
.placeholder {
  position: absolute;
  left: 0;
  right: 0;
  top: 112rpx;
  text-align: center;
  color: #cbd5e1;
  font-size: 28rpx;
  pointer-events: none;
}
.clear { margin-top: 12rpx; text-align: right; color: #2563eb; font-size: 26rpx; }
.agree {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 8rpx 4rpx 20rpx;
  color: #344054;
  font-size: 26rpx;
}
.box {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid #cbd5e1;
  box-sizing: border-box;
  flex-shrink: 0;
}
.box.on { background: #2563eb; border-color: #2563eb; }
.submit, .go { height: 92rpx; border-radius: 46rpx; font-size: 32rpx; }
.go { margin-top: 24rpx; }
.sign-box {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e5e7eb;
}
.sign-label {
  margin-bottom: 10rpx;
  color: #667085;
  font-size: 24rpx;
}
.sign-img {
  width: 100%;
  height: 180rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}
.tip {
  background: #fff7ed;
  color: #9a3412;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.badge {
  display: inline-block;
  background: #ecfdf3;
  color: #027a48;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  margin-bottom: 12rpx;
}
.badge.amber { background: #fff7ed; color: #9a3412; }
.annex-title { font-weight: 650; margin-bottom: 8rpx; font-size: 26rpx; }
.annex-body { white-space: pre-wrap; color: #344054; font-size: 24rpx; line-height: 1.6; }
.hist-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
  font-size: 24rpx;
  color: #475467;
}
.hist-row .link { color: #2563eb; }
.btn-block { width: 100%; margin-top: 20rpx; }
.sub { color: #667085; font-size: 26rpx; line-height: 1.5; margin-top: 8rpx; }
