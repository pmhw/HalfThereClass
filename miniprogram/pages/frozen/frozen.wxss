.page {
  min-height: 100vh;
  padding: 80rpx 40rpx;
  box-sizing: border-box;
  background: #f4f7fb;
  display: flex;
  align-items: center;
  justify-content: center;
}
.card {
  width: 100%;
  background: #fff;
  border-radius: 32rpx;
  padding: 56rpx 40rpx 40rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.06);
}
.mark {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  background: #fef2f2;
  color: #dc2626;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 96rpx;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
}
.desc {
  margin-top: 16rpx;
  color: #667085;
  font-size: 28rpx;
  line-height: 1.6;
}
.btn {
  margin-top: 36rpx;
  background: #2563eb;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
}
.ghost {
  margin-top: 16rpx;
  background: #f4f7fb;
  color: #344054;
}
button::after { border: none; }
