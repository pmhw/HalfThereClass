<view class="page">
  <view class="title">登记调课</view>
  <view class="sub">任课老师登记后，课表会自动改掉这一天。周六周日、节假日也可以调课或加课。</view>

  <view class="tip card" wx:if="{{!courses.length}}">还没有任课。认证并抢课后才能登记。</view>

  <block wx:else>
    <view class="field card">
      <view class="label">课程</view>
      <picker mode="selector" range="{{courses}}" range-key="title" value="{{courseIndex}}" bindchange="onCourse">
        <view>{{courses[courseIndex].title}}</view>
      </picker>
    </view>
    <view class="field card">
      <view class="label">类型</view>
      <picker mode="selector" range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="onType">
        <view>{{types[typeIndex].label}}</view>
      </picker>
    </view>
    <view class="field card">
      <view class="label">{{typeIndex === 0 ? '原上课日期' : '日期'}}</view>
      <picker mode="date" value="{{date}}" bindchange="onDate">
        <view>{{date || '请选择'}}</view>
      </picker>
    </view>
    <view class="field card" wx:if="{{typeIndex === 0}}">
      <view class="label">调到</view>
      <picker mode="date" value="{{toDate}}" bindchange="onToDate">
        <view>{{toDate || '请选择'}}</view>
      </picker>
    </view>
    <view class="field card" wx:if="{{typeIndex === 0 || typeIndex === 1}}">
      <view class="label">开始时间</view>
      <picker mode="time" value="{{startTime}}" bindchange="onStart">
        <view>{{startTime || '请选择'}}</view>
      </picker>
    </view>
    <view class="field card" wx:if="{{typeIndex === 0 || typeIndex === 1}}">
      <view class="label">结束时间</view>
      <picker mode="time" value="{{endTime}}" bindchange="onEnd">
        <view>{{endTime || '请选择'}}</view>
      </picker>
    </view>
    <view class="field card">
      <view class="label">备注</view>
      <input placeholder="选填" value="{{note}}" bindinput="onNote" />
    </view>
    <button class="btn btn-primary btn-block submit" bindtap="submit">提交并修正课表</button>
  </block>
</view>
