.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 28rpx calc(220rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
}
.nav { display: flex; align-items: center; }
.nav-title { font-size: 52rpx; font-weight: 700; color: #111827; line-height: 1; }
.subrow { margin-top: 8rpx; display: flex; align-items: center; justify-content: space-between; }
.sub { color: #98a2b3; font-size: 28rpx; }
.chip {
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #344054;
  font-size: 26rpx;
  box-shadow: 0 6rpx 16rpx rgba(17, 24, 39, .04);
}
.cal {
  width: 26rpx; height: 24rpx; border: 3rpx solid #2563eb; border-radius: 6rpx; box-sizing: border-box; position: relative;
}
.cal::before, .cal::after {
  content: ''; position: absolute; top: -7rpx; width: 3rpx; height: 8rpx; background: #2563eb; border-radius: 3rpx;
}
.cal::before { left: 4rpx; }
.cal::after { right: 4rpx; }
.chev { color: #98a2b3; font-size: 22rpx; margin-top: -4rpx; }

.lesson {
  margin-top: 24rpx;
  padding: 28rpx 24rpx 22rpx;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 28rpx rgba(17, 24, 39, .04);
}
.top { display: flex; align-items: flex-start; gap: 18rpx; }
.mark {
  width: 96rpx; height: 96rpx; border-radius: 24rpx; flex-shrink: 0;
  color: #fff; font-size: 40rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.mark.blue { background: linear-gradient(160deg, #60a5fa, #2563eb); }
.mark.purple { background: linear-gradient(160deg, #c4b5fd, #7c5cfc); }
.info { flex: 1; min-width: 0; }
.title { font-size: 32rpx; font-weight: 700; color: #111827; }
.meta { margin-top: 6rpx; color: #98a2b3; font-size: 24rpx; }
.place { margin-top: 6rpx; display: flex; align-items: center; gap: 6rpx; color: #98a2b3; font-size: 24rpx; }
.pin {
  width: 16rpx; height: 16rpx; border: 3rpx solid #98a2b3; border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg); box-sizing: border-box; flex-shrink: 0;
}
.tag {
  flex-shrink: 0; height: 44rpx; line-height: 44rpx; padding: 0 16rpx;
  border-radius: 999rpx; font-size: 22rpx;
}
.tag.mine { color: #2563eb; background: #e8f0ff; }
.tag.wait { color: #98a2b3; background: #f3f5f8; }
.line { height: 1rpx; margin: 22rpx 0 18rpx; background: #eef2f6; }
.bottom { display: flex; align-items: center; }
.cell { flex: 1; min-width: 0; display: flex; align-items: center; gap: 14rpx; }
.vline { width: 1rpx; height: 64rpx; background: #eef2f6; margin: 0 8rpx; }
.label { color: #98a2b3; font-size: 22rpx; }
.value { margin-top: 4rpx; color: #111827; font-size: 30rpx; font-weight: 700; }
.value.fee { color: #2563eb; }
.value.off { color: #98a2b3; font-size: 26rpx; font-weight: 500; }
.clock, .coin { width: 36rpx; height: 36rpx; position: relative; flex-shrink: 0; }
.clock { border: 3rpx solid #2563eb; border-radius: 50%; box-sizing: border-box; }
.clock::before {
  content: ''; position: absolute; left: 14rpx; top: 6rpx; width: 3rpx; height: 10rpx; background: #2563eb;
}
.clock::after {
  content: ''; position: absolute; left: 14rpx; top: 14rpx; width: 8rpx; height: 3rpx; background: #2563eb;
}
.coin {
  border: 3rpx solid #2563eb; border-radius: 50%; box-sizing: border-box;
}
.coin::after {
  content: ''; position: absolute; left: 4rpx; right: 4rpx; top: -8rpx; height: 10rpx;
  border: 3rpx solid #2563eb; border-radius: 50%; box-sizing: border-box; background: #f7f8fa;
}

.empty { margin-top: 28rpx; padding: 36rpx 24rpx; text-align: center; color: #98a2b3; background: #fff; border-radius: 32rpx; }
.foot { margin-top: 48rpx; text-align: center; color: #c5cad3; font-size: 24rpx; }
.art { width: 120rpx; height: 88rpx; margin: 0 auto 12rpx; position: relative; opacity: .55; }
.doc {
  position: absolute; left: 18rpx; top: 8rpx; width: 64rpx; height: 72rpx;
  border: 3rpx solid #bfdbfe; border-radius: 8rpx; box-sizing: border-box; background: #f8fbff;
}
.doc::before {
  content: ''; position: absolute; left: 12rpx; right: 12rpx; top: 16rpx; height: 3rpx; background: #dbeafe;
  box-shadow: 0 12rpx 0 #dbeafe, 0 24rpx 0 #dbeafe;
}
.glass {
  position: absolute; right: 8rpx; bottom: 6rpx; width: 36rpx; height: 36rpx;
  border: 4rpx solid #93c5fd; border-radius: 50%; box-sizing: border-box;
}
.glass::after {
  content: ''; position: absolute; right: -10rpx; bottom: -8rpx; width: 16rpx; height: 4rpx;
  background: #93c5fd; border-radius: 4rpx; transform: rotate(40deg);
}
