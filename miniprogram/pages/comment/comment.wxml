<view class="page">
  <!-- 评分 -->
  <view class="rating-section card">
    <text class="label">课程评分</text>
    <view class="stars">
      <text class="star {{index < rating ? 'active' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-rating="{{item}}" bindtap="onRatingTap">★</text>
    </view>
  </view>

  <!-- 评价内容 -->
  <view class="content-section card">
    <textarea
      class="textarea"
      placeholder="分享你的学习体验吧～"
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="500"
    ></textarea>
    <view class="char-count">{{content.length}}/500</view>

    <!-- 图片上传 -->
    <view class="image-list">
      <view class="image-item" wx:for="{{images}}" wx:key="*this">
        <image class="image" src="{{item}}" mode="aspectFill"></image>
        <view class="delete-btn" data-index="{{index}}" bindtap="onDeleteImage">×</view>
      </view>
      <view class="image-add" wx:if="{{images.length < 9}}" bindtap="onAddImage">
        <text class="add-icon">+</text>
        <text class="add-text">图片</text>
      </view>
    </view>
  </view>

  <!-- 匿名评价 -->
  <view class="anonymous-section card">
    <text class="label">匿名评价</text>
    <switch checked="{{isAnonymous}}" bindchange="onAnonymousChange" color="#ff6b35" />
  </view>

  <!-- 提交 -->
  <view class="submit-section">
    <button class="btn btn-primary btn-block" bindtap="onSubmit" loading="{{submitting}}">提交评价</button>
  </view>
</view>
