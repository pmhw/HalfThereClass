<view class="page">
  <!-- 搜索框 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索课程"
        value="{{keyword}}"
        bindinput="onInput"
        bindconfirm="onSearch"
        focus="{{true}}"
        confirm-type="search"
      />
    </view>
    <text class="cancel-btn" bindtap="onCancel">取消</text>
  </view>

  <!-- 搜索前：历史和热门 -->
  <view class="search-placeholder" wx:if="{{!isSearched}}">
    <!-- 搜索历史 -->
    <view class="section" wx:if="{{historyList.length > 0}}">
      <view class="section-header">
        <text class="section-title">搜索历史</text>
        <text class="clear-btn" bindtap="clearHistory">清空</text>
      </view>
      <view class="tag-list">
        <view class="tag" wx:for="{{historyList}}" wx:key="*this" data-keyword="{{item}}" bindtap="onHistoryTap">{{item}}</view>
      </view>
    </view>

    <!-- 热门搜索 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">热门搜索</text>
      </view>
      <view class="tag-list">
        <view class="tag hot" wx:for="{{hotList}}" wx:key="*this" data-keyword="{{item}}" bindtap="onHotTap">{{item}}</view>
      </view>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view class="search-result" wx:else>
    <view class="result-list" wx:if="{{courseList.length > 0}}">
      <course-card course="{{item}}" type="horizontal" wx:for="{{courseList}}" wx:key="id"></course-card>
    </view>
    <view class="empty" wx:else>
      <text>暂无相关课程</text>
    </view>
  </view>
</view>
