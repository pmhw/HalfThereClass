.page { padding: 48rpx 32rpx; text-align: center; }
.title { font-size: 40rpx; font-weight: 700; }
.time { margin-top: 12rpx; font-size: 32rpx; }
.meta { margin-top: 8rpx; color: #6b7280; font-size: 26rpx; }
.circle {
  width: 360rpx;
  height: 360rpx;
  margin: 80rpx auto;
  border-radius: 50%;
  background: #2563eb;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.circle.done { background: #059669; }
.circle-text { font-size: 40rpx; font-weight: 700; }
.status { padding: 28rpx; text-align: left; }
