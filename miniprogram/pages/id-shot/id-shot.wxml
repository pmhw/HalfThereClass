<privacy-popup />
<view class="page">
  <view style="height: {{padTop}}px;"></view>
  <view class="nav" style="height: {{navH}}px;">
    <view class="back" bindtap="back"></view>
    <text class="nav-title">拍摄身份证</text>
    <text class="side">{{side === 'emblem' ? '国徽面' : '人像面'}}</text>
  </view>

  <view class="lead">
    <view class="lead-title">请拍摄本人身份证</view>
    <view class="lead-sub">确保身份证完整、清晰、无遮挡</view>
  </view>

  <view class="card">
    <view class="frame-label">请将身份证放入框内</view>
    <view class="frame">
      <camera
        wx:if="{{phase === 'cam'}}"
        class="cam"
        device-position="back"
        flash="off"
        resolution="high"
        bindinitdone="onCamReady"
        binderror="onCamError"
      >
        <cover-view class="cam-ring"></cover-view>
        <cover-view class="corner c-tl"></cover-view>
        <cover-view class="corner c-tr"></cover-view>
        <cover-view class="corner c-bl"></cover-view>
        <cover-view class="corner c-br"></cover-view>
        <cover-view wx:if="{{side === 'portrait'}}" class="ghost-photo"></cover-view>
        <cover-view wx:else class="ghost-emblem"></cover-view>
      </camera>
      <image wx:elif="{{phase === 'preview'}}" class="shot" src="{{preview}}" mode="aspectFill"></image>
      <view wx:else class="sample">
        <view class="sample-copy">
          <view class="bar long"></view>
          <view class="bar mid"></view>
          <view class="bar short"></view>
          <view class="sample-note">示例轮廓</view>
        </view>
        <view wx:if="{{side === 'portrait'}}" class="sample-photo"></view>
        <view wx:else class="sample-emblem"></view>
      </view>
      <view wx:if="{{phase !== 'cam'}}" class="ring"></view>
      <view wx:if="{{phase !== 'cam'}}" class="corner c-tl"></view>
      <view wx:if="{{phase !== 'cam'}}" class="corner c-tr"></view>
      <view wx:if="{{phase !== 'cam'}}" class="corner c-bl"></view>
      <view wx:if="{{phase !== 'cam'}}" class="corner c-br"></view>
    </view>
    <view class="status {{statusTone}}">
      <text wx:if="{{statusTone === 'ok'}}" class="tick">✓</text>
      {{statusText}}
    </view>
  </view>

  <view wx:if="{{phase !== 'preview'}}" class="shoot-box">
    <view class="shutter" bindtap="onShutter">
      <view class="shutter-in"></view>
    </view>
    <text class="shoot-label">拍摄</text>
  </view>
  <view wx:else class="confirm">
    <view class="ghost-btn" bindtap="retake">重拍</view>
    <view class="use-btn" bindtap="usePhoto">使用照片</view>
  </view>

  <view class="reqs">
    <view class="req">✓ 身份证四角完整</view>
    <view class="req">✓ 文字清晰可见</view>
    <view class="req">✓ 避免反光</view>
    <view class="req">✓ 请勿遮挡身份证</view>
    <view class="req">✓ 请使用本人身份证</view>
  </view>

  <canvas type="2d" id="crop" class="crop"></canvas>
</view>
