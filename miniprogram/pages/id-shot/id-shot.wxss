.page { min-height: 100vh; background: #000; }
.cam { position: fixed; left: 0; top: 0; width: 100vw; height: 100vh; }
.dim { position: absolute; background: rgba(0, 0, 0, 0.62); }
.corner { position: absolute; width: 28px; height: 28px; border-style: solid; border-color: #fff; border-width: 0; box-sizing: border-box; }
.guide { position: absolute; box-sizing: border-box; border: 2px solid rgba(255, 255, 255, 0.85); }
.guide.photo { width: 62px; height: 78px; border-radius: 4px; }
.guide.emblem { width: 36px; height: 36px; border-radius: 18px; }
.nav-back, .nav-title, .tip, .tool { position: absolute; color: #fff; text-align: center; }
.nav-back { left: 16px; width: 52px; font-size: 16px; }
.nav-title { left: 72px; right: 72px; font-size: 17px; font-weight: 600; }
.tip { font-size: 14px; color: #fff; }
.tool { width: 52px; height: 36px; line-height: 36px; font-size: 15px; color: #fff; }
.shutter {
  position: absolute; width: 74px; height: 74px; border-radius: 37px;
  border: 4px solid #fff; box-sizing: border-box;
}
.shutter-in {
  position: absolute; left: 6px; top: 6px; width: 54px; height: 54px; border-radius: 27px; background: #fff;
}
.preview { min-height: 100vh; background: #0b0f19; display: flex; flex-direction: column; }
.nav { position: relative; display: flex; align-items: center; justify-content: center; }
.back { position: absolute; left: 24rpx; color: #fff; font-size: 30rpx; display: flex; align-items: center; }
.title { color: #fff; font-size: 32rpx; font-weight: 600; display: flex; align-items: center; }
.sheet { flex: 1; display: flex; align-items: center; justify-content: center; padding: 32rpx; }
.shot { width: 640rpx; height: 404rpx; background: #111; border-radius: 16rpx; }
.actions { display: flex; gap: 24rpx; padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); }
.ghost, .use {
  flex: 1; height: 88rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center;
  font-size: 30rpx;
}
.ghost { color: #fff; background: rgba(255, 255, 255, 0.12); }
.use { color: #fff; background: #2563eb; font-weight: 650; }
.crop { position: fixed; left: 0; top: 0; width: 2px; height: 2px; opacity: 0; }
