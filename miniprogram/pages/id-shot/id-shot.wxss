.page {
  min-height: 100vh;
  padding: 0 28rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #f4f7fb;
  box-sizing: border-box;
}
.nav { display: flex; align-items: center; }
.back {
  width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.back::before {
  content: ''; width: 16rpx; height: 16rpx; margin-left: 6rpx;
  border-left: 4rpx solid #111827; border-bottom: 4rpx solid #111827; transform: rotate(45deg);
}
.nav-title { margin-left: 4rpx; font-size: 34rpx; font-weight: 650; color: #111827; }
.side {
  margin-left: 12rpx; height: 36rpx; line-height: 36rpx; padding: 0 14rpx;
  border-radius: 999rpx; background: #e8f0ff; color: #2563eb; font-size: 22rpx; font-weight: 650;
}
.lead { margin: 28rpx 8rpx 20rpx; }
.lead-title { font-size: 40rpx; font-weight: 700; color: #111827; line-height: 1.3; }
.lead-sub { margin-top: 8rpx; color: #667085; font-size: 26rpx; line-height: 1.5; }

.card {
  background: #fff; border-radius: 28rpx; padding: 28rpx 24rpx 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.04);
}
.frame-label { text-align: center; color: #344054; font-size: 28rpx; font-weight: 650; }
.frame {
  position: relative; width: 100%; margin-top: 20rpx;
  aspect-ratio: 85.6 / 53.98; border-radius: 20rpx; overflow: hidden; background: #eef3fb;
}
.cam, .shot, .sample { width: 100%; height: 100%; }
.cam-ring {
  position: absolute; left: 8px; top: 8px; width: 100%; height: 100%;
  margin-left: -8px; margin-top: -8px; box-sizing: border-box;
  border: 2px dashed #3b82f6; border-radius: 12px;
}
.sample {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx; box-sizing: border-box;
}
.sample-copy { flex: 1; min-width: 0; }
.bar { height: 16rpx; margin-bottom: 14rpx; border-radius: 8rpx; background: #d7e3f8; }
.bar.long { width: 78%; }
.bar.mid { width: 62%; }
.bar.short { width: 40%; }
.sample-note { margin-top: 8rpx; color: #93a4bd; font-size: 22rpx; }
.sample-photo {
  width: 108rpx; height: 136rpx; margin-left: 20rpx; border-radius: 12rpx;
  background: #dbe7fb; border: 2rpx solid #bfd3fe; flex-shrink: 0;
}
.sample-emblem {
  width: 88rpx; height: 88rpx; margin-left: 20rpx; border-radius: 50%;
  border: 8rpx solid #bfd3fe; box-sizing: border-box; flex-shrink: 0;
}
.ring {
  position: absolute; left: 8rpx; top: 8rpx; right: 8rpx; bottom: 8rpx;
  border: 3rpx dashed #2563eb; border-radius: 16rpx; pointer-events: none;
  box-shadow: 0 0 0 8rpx rgba(37, 99, 235, 0.08), 0 0 28rpx rgba(37, 99, 235, 0.28);
}
.corner {
  position: absolute; width: 36rpx; height: 36rpx; border-style: solid; border-color: #2563eb; border-width: 0; box-sizing: border-box;
}
.c-tl { left: 10rpx; top: 10rpx; border-left-width: 6rpx; border-top-width: 6rpx; border-top-left-radius: 8rpx; }
.c-tr { right: 10rpx; top: 10rpx; border-right-width: 6rpx; border-top-width: 6rpx; border-top-right-radius: 8rpx; }
.c-bl { left: 10rpx; bottom: 10rpx; border-left-width: 6rpx; border-bottom-width: 6rpx; border-bottom-left-radius: 8rpx; }
.c-br { right: 10rpx; bottom: 10rpx; border-right-width: 6rpx; border-bottom-width: 6rpx; border-bottom-right-radius: 8rpx; }
.ghost-photo {
  position: absolute; right: 28rpx; top: 28rpx; width: 72rpx; height: 92rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.85); border-radius: 8rpx;
}
.ghost-emblem {
  position: absolute; left: 28rpx; top: 24rpx; width: 52rpx; height: 52rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.85); border-radius: 26rpx;
}
.status {
  margin-top: 20rpx; text-align: center; font-size: 26rpx; font-weight: 650; color: #667085;
}
.status.ok { color: #059669; }
.status.warn { color: #b45309; }
.tick { margin-right: 8rpx; }

.shoot-box { display: flex; flex-direction: column; align-items: center; margin-top: 36rpx; }
.shutter {
  width: 128rpx; height: 128rpx; border-radius: 50%; background: #2563eb;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, 0.35);
}
.shutter-in {
  width: 52rpx; height: 40rpx; border: 4rpx solid #fff; border-radius: 10rpx; box-sizing: border-box; position: relative;
}
.shutter-in::before {
  content: ''; position: absolute; left: 8rpx; top: -10rpx; width: 16rpx; height: 8rpx;
  border: 4rpx solid #fff; border-bottom: 0; border-radius: 6rpx 6rpx 0 0; box-sizing: border-box;
}
.shutter-in::after {
  content: ''; position: absolute; left: 16rpx; top: 10rpx; width: 12rpx; height: 12rpx;
  border: 4rpx solid #fff; border-radius: 50%; box-sizing: border-box;
}
.shoot-label { margin-top: 14rpx; color: #111827; font-size: 28rpx; font-weight: 650; }

.confirm { display: flex; gap: 20rpx; margin-top: 32rpx; }
.ghost-btn, .use-btn {
  flex: 1; height: 88rpx; border-radius: 44rpx; display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 650;
}
.ghost-btn { background: #fff; color: #344054; }
.use-btn { background: #2563eb; color: #fff; }

.reqs {
  margin-top: 28rpx; padding: 8rpx 8rpx 0; display: flex; flex-wrap: wrap; gap: 12rpx 20rpx;
}
.req { color: #667085; font-size: 24rpx; line-height: 1.6; }
.crop { position: fixed; left: -999px; top: 0; width: 2px; height: 2px; }
