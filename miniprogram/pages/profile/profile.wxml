<view class="page">
  <!-- 头像 -->
  <view class="form-item" bindtap="onChangeAvatar">
    <text class="label">头像</text>
    <view class="value-wrap">
      <image class="avatar" src="{{avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 昵称 -->
  <view class="form-item">
    <text class="label">昵称</text>
    <input class="input" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput" maxlength="20" />
  </view>

  <!-- 保存按钮 -->
  <view class="save-section">
    <button class="btn btn-primary btn-block" bindtap="onSave" loading="{{loading}}">保存</button>
  </view>
</view>
