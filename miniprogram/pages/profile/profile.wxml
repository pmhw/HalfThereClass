<view class="page">
  <!-- 头像 -->
  <form bindsubmit="onSave">
    <button class="form-item avatar-row" hover-class="none" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <text class="label">头像</text>
      <view class="value-wrap">
        <image class="avatar" src="{{avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
        <text class="arrow">用微信头像</text>
      </view>
    </button>

    <view class="form-item">
      <text class="label">昵称</text>
      <input class="input" type="nickname" name="nickname" placeholder="点这里，选微信昵称" value="{{nickname}}" bindinput="onNicknameInput" bindchange="onNicknameInput" bindblur="onNicknameInput" maxlength="30" />
    </view>

    <view class="save-section">
      <button class="btn btn-primary btn-block" form-type="submit" loading="{{loading}}">保存</button>
    </view>
  </form>
  <privacy-popup />
</view>
