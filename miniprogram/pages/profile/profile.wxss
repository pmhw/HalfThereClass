.page {
  background: #f7f8fa;
  min-height: 100vh;
  padding-top: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f5f5f5;
}

.label {
  width: 160rpx;
  font-size: 30rpx;
  color: #333;
  flex-shrink: 0;
}

.value-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}

.arrow {
  color: #ccc;
  font-size: 32rpx;
  margin-left: 12rpx;
}

.input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: #333;
}

.save-section {
  padding: 60rpx 24rpx;
}
