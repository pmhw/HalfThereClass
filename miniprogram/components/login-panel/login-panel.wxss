.page {
  min-height: 100vh;
  background: #fff;
  padding: 72rpx 56rpx calc(220rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.brand { text-align: center; }
.mark {
  width: 176rpx;
  height: 176rpx;
  margin: 0 auto 28rpx;
  border-radius: 48rpx;
  background: #eef4ff;
  color: #2563eb;
  font-size: 72rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.app-name { font-size: 56rpx; font-weight: 700; color: #111827; }
.brand-en { margin-top: 4rpx; color: #98a2b3; font-size: 24rpx; letter-spacing: 6rpx; }
.slogan { margin-top: 16rpx; color: #6b7280; font-size: 30rpx; }
.form { margin-top: 28rpx; }
.is-profile { justify-content: flex-start; padding-top: 48rpx; }
.is-profile .mark {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 16rpx;
  border-radius: 28rpx;
  font-size: 40rpx;
}
.is-profile .app-name { font-size: 40rpx; }
.is-profile .brand-en { font-size: 20rpx; letter-spacing: 4rpx; }
.is-profile .slogan { margin-top: 8rpx; font-size: 26rpx; }
.is-profile .hint { margin-top: 16rpx; font-size: 24rpx; }
.step-title { text-align: center; font-size: 32rpx; font-weight: 700; color: #111827; }
.avatar-slot {
  width: 112rpx;
  height: 112rpx;
  margin: 28rpx auto 0;
  border-radius: 50%;
  overflow: hidden;
}
.avatar-btn {
  width: 112rpx !important;
  height: 112rpx !important;
  min-width: 112rpx !important;
  min-height: 112rpx !important;
  max-width: 112rpx !important;
  max-height: 112rpx !important;
  padding: 0 !important;
  margin: 0;
  border: 0;
  border-radius: 50%;
  background: #eef4ff;
  color: #2563eb;
  font-size: 22rpx;
  line-height: 112rpx;
  overflow: hidden;
  box-sizing: border-box;
}
.avatar-btn::after {
  border: none;
  border-radius: 50%;
}
.avatar-btn image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: block;
}
.hint { margin: 36rpx 8rpx 0; text-align: center; color: #98a2b3; font-size: 26rpx; line-height: 1.6; }
.nick-wrap {
  margin-top: 24rpx;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #f7f8fa;
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
}
.nick-wrap.warn { border-color: #93c5fd; background: #f8fbff; }
.nick-label { color: #667085; font-size: 28rpx; flex-shrink: 0; }
.nick {
  flex: 1;
  height: 84rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  font-size: 28rpx;
  color: #111827;
}
.nick-placeholder { color: #98a2b3; }
.field-tip { margin-top: 12rpx; text-align: center; color: #2563eb; font-size: 24rpx; }
.login-btn {
  width: 100%;
  height: 96rpx;
  margin: 36rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #2563eb;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 96rpx;
  box-sizing: border-box;
}
.login-btn::after { border: none; }
.login-btn-hover { background: #1d4ed8; }
.login-btn.ghost {
  background: #eef4ff;
  color: #2563eb;
}
.login-btn[disabled] { background: #93c5fd; color: #fff; }
.agree { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 32rpx; }
.box {
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  border: 2rpx solid #d0d5dd;
  border-radius: 8rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}
.box.on {
  border-color: #2563eb;
  background: #2563eb;
  position: relative;
}
.box.on::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 4rpx;
  width: 8rpx;
  height: 16rpx;
  border-right: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(45deg);
}
.agree-text { flex: 1; color: #667085; font-size: 26rpx; line-height: 1.6; }
.link { color: #2563eb; }
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 24, 39, .45);
  display: flex;
  align-items: flex-end;
  z-index: 30;
}
.sheet {
  width: 100%;
  max-height: 76vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 32rpx 48rpx;
  box-sizing: border-box;
}
.sheet-head { display: flex; align-items: center; justify-content: space-between; font-size: 32rpx; font-weight: 650; }
.close { width: 56rpx; text-align: center; color: #98a2b3; font-size: 40rpx; }
.sheet-body { height: 52vh; margin-top: 20rpx; }
.sheet-text { color: #344054; font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; }
.privacy {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
