.lesson-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.lesson-item:last-child {
  border-bottom: none;
}

.lesson-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fff0eb;
  color: #ff6b35;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.lesson-item.status-locked .lesson-icon {
  background: #f0f0f0;
  color: #999;
}

.lesson-item.status-completed .lesson-icon {
  background: #e8f9ef;
  color: #07c160;
}

.lesson-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.lesson-title {
  font-size: 30rpx;
  color: #333;
}

.lesson-item.status-locked .lesson-title {
  color: #999;
}

.lesson-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  display: flex;
  gap: 12rpx;
}

.free-tag {
  color: #07c160;
  background: #e8f9ef;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.lesson-arrow {
  color: #ccc;
  font-size: 32rpx;
  margin-left: 12rpx;
}
